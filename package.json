{
  "name": "@edgraph-oss/shared-forms",
  "version": "1.3.4",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./templates": {
      "types": "./dist/components/templates/index.d.ts",
      "import": "./dist/components/templates/index.js",
      "require": "./dist/components/templates/index.cjs",
      "default": "./dist/components/templates/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs",
      "default": "./dist/ui/index.js"
    },
    "./widgets": {
      "types": "./dist/components/widgets/index.d.ts",
      "import": "./dist/components/widgets/index.js",
      "require": "./dist/components/widgets/index.cjs",
      "default": "./dist/components/widgets/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js",
      "require": "./dist/models/index.cjs",
      "default": "./dist/models/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs",
      "default": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dist": "rm -rf ./dist && tsc && vite build",
    "preview": "vite preview",
    "prepare": "rm -rf ./dist && tsc && vite build"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^3.34.0",
    "@emotion/react": "^11.14.0",
    "@fontsource/archivo-narrow": "^5.2.8",
    "@fontsource/open-sans": "^5.2.7",
    "@fontsource/poppins": "^5.2.7",
    "@rjsf/chakra-ui": "6.4.2",
    "@rjsf/core": "6.4.2",
    "@rjsf/utils": "6.4.2",
    "@rjsf/validator-ajv8": "6.4.2",
    "chakra-dayzed-datepicker": "^3.0.0",
    "chakra-react-select": "^6.1.1",
    "json-schema": "^0.4.0",
    "lodash-es": "^4.18.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "luxon": "^3.7.2",
    "typescript": "~5.9.3",
    "vite": "~7.3.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "resolutions": {
    "axios": "^1.15.0"
  },
  "keywords": [
    "npm",
    "shared-forms"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EdWire/edgraph_shared_forms"
  }
}
